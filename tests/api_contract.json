{
  "paths": {
    "/api/v1/analyze": {
      "post": {
        "summary": "Analyze",
        "operationId": "analyze_api_v1_analyze_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_api_v1_analyze_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Submitted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_api_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Processing"
                    },
                    {
                      "$ref": "#/components/schemas/Done"
                    },
                    {
                      "$ref": "#/components/schemas/Failed"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "processing": "#/components/schemas/Processing",
                      "done": "#/components/schemas/Done",
                      "failed": "#/components/schemas/Failed"
                    }
                  },
                  "title": "Response Get Job Api V1 Jobs  Job Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "schemas": {
    "Body_analyze_api_v1_analyze_post": {
      "properties": {
        "file": {
          "type": "string",
          "contentMediaType": "application/octet-stream",
          "title": "File"
        }
      },
      "type": "object",
      "required": [
        "file"
      ],
      "title": "Body_analyze_api_v1_analyze_post"
    },
    "Body_ui_analyze_ui_api_analyze_post": {
      "properties": {
        "file": {
          "type": "string",
          "contentMediaType": "application/octet-stream",
          "title": "File"
        }
      },
      "type": "object",
      "required": [
        "file"
      ],
      "title": "Body_ui_analyze_ui_api_analyze_post"
    },
    "Done": {
      "properties": {
        "job_id": {
          "type": "string",
          "title": "Job Id"
        },
        "status": {
          "type": "string",
          "const": "done",
          "title": "Status"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "violation",
            "no_violation"
          ],
          "title": "Verdict"
        },
        "violations": {
          "items": {
            "$ref": "#/components/schemas/Violation"
          },
          "type": "array",
          "title": "Violations"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "job_id",
        "status",
        "verdict",
        "violations"
      ],
      "title": "Done"
    },
    "Evidence": {
      "properties": {
        "timestamp_sec": {
          "type": "number",
          "minimum": 0.0,
          "title": "Timestamp Sec"
        },
        "image_base64": {
          "type": "string",
          "title": "Image Base64"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "timestamp_sec",
        "image_base64"
      ],
      "title": "Evidence"
    },
    "Failed": {
      "properties": {
        "job_id": {
          "type": "string",
          "title": "Job Id"
        },
        "status": {
          "type": "string",
          "const": "failed",
          "title": "Status"
        },
        "error": {
          "type": "string",
          "title": "Error"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "job_id",
        "status",
        "error"
      ],
      "title": "Failed"
    },
    "HTTPValidationError": {
      "properties": {
        "detail": {
          "items": {
            "$ref": "#/components/schemas/ValidationError"
          },
          "type": "array",
          "title": "Detail"
        }
      },
      "type": "object",
      "title": "HTTPValidationError"
    },
    "Processing": {
      "properties": {
        "job_id": {
          "type": "string",
          "title": "Job Id"
        },
        "status": {
          "type": "string",
          "const": "processing",
          "title": "Status"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "job_id",
        "status"
      ],
      "title": "Processing"
    },
    "Submitted": {
      "properties": {
        "job_id": {
          "type": "string",
          "title": "Job Id"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "job_id"
      ],
      "title": "Submitted"
    },
    "ValidationError": {
      "properties": {
        "loc": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "type": "array",
          "title": "Location"
        },
        "msg": {
          "type": "string",
          "title": "Message"
        },
        "type": {
          "type": "string",
          "title": "Error Type"
        },
        "input": {
          "title": "Input"
        },
        "ctx": {
          "type": "object",
          "title": "Context"
        }
      },
      "type": "object",
      "required": [
        "loc",
        "msg",
        "type"
      ],
      "title": "ValidationError"
    },
    "Violation": {
      "properties": {
        "type": {
          "type": "string",
          "title": "Type"
        },
        "timecode_sec": {
          "type": "number",
          "minimum": 0.0,
          "title": "Timecode Sec"
        },
        "description": {
          "type": "string",
          "title": "Description"
        },
        "evidence_frames": {
          "items": {
            "$ref": "#/components/schemas/Evidence"
          },
          "type": "array",
          "maxItems": 3,
          "minItems": 1,
          "title": "Evidence Frames"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "timecode_sec",
        "description",
        "evidence_frames"
      ],
      "title": "Violation"
    }
  }
}
