# Адрес бэкенда. Пусто = тот же origin (в dev запросы /api/* проксируются на API_PROXY_TARGET).
VITE_API_BASE=
# Необязательно: ключ для заголовка X-API-Key (если фронт ходит в защищённый API напрямую).
VITE_API_KEY=
# true = по умолчанию работать на заглушке (пока API не готов); false = на реальном API.
VITE_USE_MOCK=true
# Куда проксировать /api в dev-режиме.
API_PROXY_TARGET=http://localhost:8000
